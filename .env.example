# Copy to .env for local settings. .env is gitignored. NEVER commit real credentials.
#
# Live trading is disabled in code (systrade/safety.py). Setting this to true
# makes the program refuse to run; it does not enable live orders.
LIVE_TRADING_ENABLED=false

# Optional: data-provider API key. The default provider (yfinance) does not use one.
# DATA_PROVIDER_API_KEY=

# Broker credentials do NOT belong here or anywhere in this repository.
